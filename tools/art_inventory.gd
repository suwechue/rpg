## Pack inventory (ROADMAP M12b): scans assets/packs/, writes a contact sheet
## per pack folder into tools/inventory/ and docs/ART_INVENTORY.md listing
## what each pack holds, what it suits, whether the game uses it (through
## data/assets/manifest.json), and the style guide of which pack goes where.
## Run: Godot_console.exe --headless --path . -s res://tools/art_inventory.gd
extends SceneTree

const PACKS := "res://assets/packs/"
const OUT := "res://tools/inventory/"
const THUMB := 40
const PER_SHEET := 96

## What each pack is for, and why a pack is unused (the style guide).
const ROLES := {
	"ninja_adventure": ["Characters, monsters, portraits, UI dialog, FX, items, audio; houses, nature and interior tilesets", ""],
	"kenney_tiny_town": ["Residential ground, houses, trees, fences, props", ""],
	"kenney_tiny_city": ["Downtown roads, concrete, storefronts, cars, street props", ""],
	"kenney_tiny_dungeon": ["Upside-Down floors and walls", ""],
	"dungeontileset_ii": ["Upside-Down floors, walls and extra monsters", "Planned for the mirror-town Upside-Down in M20 (floors use Tiny Dungeon until then)"],
	"kenney_tiny_battle": ["Combat props, markers and highlights", "Planned for combat props and markers in M20 (combat draws its own markers, from the M11 skin, for now)"],
	"tiny_creatures": ["Extra Upside-Down creatures", "Planned for new Upside-Down creatures in M20 (enemies use Ninja Adventure monsters now)"],
	"kenney_tiny_factory": ["The factory on the outskirts", "Planned for the factory in M17 (the outskirts don't have one yet)"],
	"kenney_ui_pixel_adventure": ["Panels, buttons, card frames (M11 skin)", "Used through edited copies in assets/ui/skin/ (M11), so the manifest points there instead of the pack"],
	"kenney_input_prompts_pixel": ["Key and controller prompts", "Planned for control hints in M22 (prompts are text for now)"],
}

const SUITS := [["tile", "ground and buildings"], ["tileset", "ground and buildings"], ["interior", "interiors"], ["character", "characters"],
	["monster", "monsters"], ["boss", "monsters"], ["fx", "VFX"], ["ui", "UI"], ["icon", "icons"], ["item", "items"], ["font", "fonts"],
	["portrait", "portraits"], ["face", "portraits"], ["input", "input prompts"], ["keyboard", "input prompts"], ["controller", "input prompts"],
	["prop", "props"], ["nature", "props"], ["house", "buildings"], ["floor", "ground and buildings"], ["wall", "ground and buildings"]]


func _initialize() -> void:
	var sources := {}
	var manifest: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/assets/manifest.json"))
	for id in manifest["assets"]:
		var src := str(manifest["assets"][id].get("source", ""))
		if src.begins_with(PACKS):
			sources[src] = str(id)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
	var lines: Array = ["# Art inventory", "",
		"Generated by `tools/art_inventory.gd` from `assets/packs/` and `data/assets/manifest.json`. Contact sheets are in `tools/inventory/<pack>.png` (and `_2`, `_3`... for big packs). Regenerate after adding packs or manifest entries.", "",
		"## Style guide (which pack goes where)", "",
		"| Area | Packs |", "| --- | --- |",
		"| Downtown | Tiny City (roads, cars, storefronts) mixed with Ninja Adventure floors and props |",
		"| Residential | Tiny Town plus Ninja Adventure TilesetHouse and TilesetNature; roofs come in tinted variants (data/town/styles.json roofTints) |",
		"| Outskirts | Ninja Adventure TilesetNature, Field, Relief and Water; Tiny Factory for the factory |",
		"| Interiors | Ninja Adventure Interior |",
		"| Upside-Down | Tiny Dungeon plus DungeonTileset II plus recolored town tiles (M20) |",
		"| Combat props and markers | Tiny Battle |",
		"| Extra creatures | Tiny Creatures for Upside-Down enemies |",
		"| UI | UI Pack Pixel Adventure (via the M11 skin) |",
		"| Input prompts | Input Prompts Pixel |", "",
		"Keep one look per zone: mixing packs is fine inside a zone as long as the zone stays consistent.", "",
		"## Packs", "",
		"| Pack | Images | Used by the game | Suits | Notes |", "| --- | --- | --- | --- | --- |"]
	var details: Array = []
	for pack in DirAccess.get_directories_at(PACKS):
		var files: Array = []
		_pngs(PACKS + pack, files)
		files.sort()
		var used := files.filter(func(f: String) -> bool: return sources.has(f))
		var suits := {}
		for f in files:
			var low := str(f).to_lower()
			for s in SUITS:
				if low.contains(str(s[0])):
					suits[str(s[1])] = true
		var role: Array = ROLES.get(pack, ["", ""])
		var note := str(role[1]) if used.is_empty() and str(role[1]) != "" else ("Unused: no use planned yet" if used.is_empty() else str(role[0]))
		lines.append("| `%s` | %d | %d | %s | %s |" % [pack, files.size(), used.size(), ", ".join(PackedStringArray(suits.keys())), note])
		var sheets := _sheets(pack, files)
		details.append("### %s" % pack)
		details.append("")
		details.append("Contact sheets: %s. Used files:" % ", ".join(PackedStringArray(sheets.map(func(p: String) -> String: return "`%s`" % p))))
		details.append("")
		if used.is_empty():
			details.append("- (none yet)")
		for f in used:
			details.append("- `%s` as `%s`" % [str(f).trim_prefix(PACKS + pack + "/"), sources[f]])
		details.append("")
	lines.append("")
	lines.append_array(details)
	var fa := FileAccess.open("res://docs/ART_INVENTORY.md", FileAccess.WRITE)
	fa.store_string("\n".join(PackedStringArray(lines)) + "\n")
	fa.close()
	print("docs/ART_INVENTORY.md written")
	quit(0)


func _pngs(dir: String, out: Array) -> void:
	for d in DirAccess.get_directories_at(dir):
		_pngs(dir + "/" + d, out)
	for f in DirAccess.get_files_at(dir):
		if f.ends_with(".png"):
			out.append(dir + "/" + f)


## Thumbnails of every image, PER_SHEET to a sheet. Returns the sheet paths.
func _sheets(pack: String, files: Array) -> Array:
	var out: Array = []
	var cols := 12
	var i := 0
	while i < files.size():
		var batch := files.slice(i, i + PER_SHEET)
		var rows := ceili(float(batch.size()) / float(cols))
		var sheet := Image.create(cols * THUMB, rows * THUMB, false, Image.FORMAT_RGBA8)
		sheet.fill(Color(0.2, 0.2, 0.22))
		for k in batch.size():
			var img := Image.load_from_file(ProjectSettings.globalize_path(str(batch[k])))
			if img == null or img.is_empty():
				continue
			img.convert(Image.FORMAT_RGBA8)
			var s := minf(float(THUMB - 2) / img.get_width(), float(THUMB - 2) / img.get_height())
			img.resize(maxi(1, int(img.get_width() * s)), maxi(1, int(img.get_height() * s)), Image.INTERPOLATE_NEAREST)
			sheet.blend_rect(img, Rect2i(Vector2i.ZERO, img.get_size()), Vector2i((k % cols) * THUMB + 1, (k / cols) * THUMB + 1))
		var name := "%s%s.png" % [pack, "" if i == 0 else "_%d" % (i / PER_SHEET + 1)]
		sheet.save_png(ProjectSettings.globalize_path(OUT + name))
		out.append("tools/inventory/" + name)
		i += PER_SHEET
	return out
