    { "id": "pk_exploit", "class": "mage", "name": "Exploit", "text": "Hits on a weakness deal +20%.", "effect": { "kind": "damagePct", "filter": { "weak": true }, "value": 0.2 }, "tags": ["weakness hunter"] },
    { "id": "pk_storm_focus", "class": "mage", "name": "Storm Focus", "text": "Lightning hits deal +25%.", "effect": { "kind": "damagePct", "filter": { "type": "lightning" }, "value": 0.25 }, "tags": ["weakness hunter"] },
    { "id": "pk_far_reach", "class": "mage", "name": "Long Stride", "text": "+1 Movement.", "effect": { "kind": "movementPlus", "value": 1 }, "tags": ["terrain controller", "mobility"] },
