{
  "comment": "C2 perks: passive rule changers (docs/COMBAT_2.md Part 4). Each perk is one effect read by src/core/combat2/perks.gd. kinds: wallSlam (+value damage when your push slams into something), oneMoreHeal (heal on One More), batonInit (receiver +value Initiative for the fight), firstSpellFree, backKnockdown (back attacks knock down), weakWhileStatus (status -> extra weak type), pinDowned (knocked-down enemies next to you can't stand), chargeMod (vector -> charges +/-), damagePct (filter: tag/type/shape/downed/back -> +value share), pushPlus (+value push tiles), killStep (move value tiles after a kill), braceExtra (+value share damage cut), healPct, batonPct (+value share Baton bonus), revealOnFirstHit, ultRate (meter x), cooldownCut (move id -> -value turns), movementPlus, initiativePlus, maxHpPlus, allOutPct, followUpPlus, protectOnce, standHeal. class: who can equip it (\"any\" for general).",
  "perks": [
    { "id": "pk_wall_slammer", "class": "fighter", "name": "Wall Slammer", "text": "Your pushes deal +4 when they slam into a wall or a unit.", "effect": { "kind": "wallSlam", "value": 4 }, "tags": ["wall-slammer"] },
    { "id": "pk_shove_plus", "class": "fighter", "name": "Long Arms", "text": "Your pushes go 1 tile further.", "effect": { "kind": "pushPlus", "value": 1 }, "tags": ["wall-slammer", "push"] },
    { "id": "pk_iron_skin", "class": "fighter", "name": "Iron Skin", "text": "+10 max HP.", "effect": { "kind": "maxHpPlus", "value": 10 }, "tags": ["protector"] },
    { "id": "pk_bodyguard", "class": "fighter", "name": "Bodyguard", "text": "Once per fight, take a killing blow meant for an adjacent ally.", "effect": { "kind": "protectOnce", "value": 1 }, "tags": ["protector"] },
    { "id": "pk_hold_ground", "class": "fighter", "name": "Hold the Ground", "text": "Bracing cuts 25% more damage.", "effect": { "kind": "braceExtra", "value": 0.25 }, "tags": ["protector"] },
    { "id": "pk_slam_cd", "class": "fighter", "name": "Quick Recovery", "text": "Heavy Slam's cooldown is 1 shorter.", "effect": { "kind": "cooldownCut", "move": "brick_heavy_slam", "value": 1 }, "tags": ["wall-slammer"] },
    { "id": "pk_brawler", "class": "fighter", "name": "Brawler", "text": "Blunt hits deal +20%.", "effect": { "kind": "damagePct", "filter": { "type": "blunt" }, "value": 0.2 }, "tags": ["wall-slammer"] },
    { "id": "pk_second_wind", "class": "fighter", "name": "Second Wind", "text": "One More also heals you 4.", "effect": { "kind": "oneMoreHeal", "value": 4 }, "tags": ["protector"] },

    { "id": "pk_weak_seeker", "class": "mage", "name": "Weakness Seeker", "text": "Your first hit on each enemy reveals all its markings.", "effect": { "kind": "revealOnFirstHit", "value": 1 }, "tags": ["weakness hunter", "scan"] },
    { "id": "pk_cold_heart", "class": "mage", "name": "Cold Heart", "text": "+1 charge on Cold spells; Heat spells have one fewer.", "effect": { "kind": "chargeMod", "mods": { "cold": 1, "heat": -1 } }, "tags": ["terrain controller"] },
    { "id": "pk_free_spell", "class": "mage", "name": "Warm-Up", "text": "Your first spell each fight costs no charge.", "effect": { "kind": "firstSpellFree", "value": 1 }, "tags": ["weakness hunter"] },
