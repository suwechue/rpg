    { "id": "pk_poison_tip", "class": "rogue", "name": "Poison Tips", "text": "Poison hits deal +30%.", "effect": { "kind": "damagePct", "filter": { "type": "poison" }, "value": 0.3 }, "tags": ["scout"] },
    { "id": "pk_scout_eye", "class": "rogue", "name": "Scout's Eye", "text": "Your first hit on each enemy reveals all its markings.", "effect": { "kind": "revealOnFirstHit", "value": 1 }, "tags": ["scout", "scan"] },

    { "id": "pk_conductor", "class": "bard", "name": "Conductor", "text": "When you Baton Pass, the receiver gets +2 Initiative for the rest of the fight.", "effect": { "kind": "batonInit", "value": 2 }, "tags": ["baton conductor"] },
    { "id": "pk_crescendo", "class": "bard", "name": "Crescendo", "text": "Baton Passes you give add 15% more damage.", "effect": { "kind": "batonPct", "value": 0.15 }, "tags": ["baton conductor"] },
