{
  "comment": "What each Vector does to each tile or prop (docs/COMBAT_LAB.md Part 3b). tiles -> tile type -> Vector -> ops. Tile types: floor, water, ice, oil, gas, wet, and prop kinds. Ops: burn, steam, terrain (to), wet, arc (damage), ignite, explode (damage). The game and the preview both read this table when the reactionsTable lever is on.",
  "burnTurns": 2,
  "steamTurns": 2,
  "wetTurns": 3,
  "spikesDamage": 2,
  "conveyorSteps": 1,
  "explosionDamage": 3,
  "gasDamage": 2,
  "allyCombos": {
    "cold+heat": { "name": "Thermal Burst", "text": "Fire meets frost: steam and a crack of force.", "ops": [{ "op": "steam" }, { "op": "hit", "n": 2 }] },
    "force+heat": { "name": "Blast Wave", "text": "Force feeds the fire: it blows.", "ops": [{ "op": "explode", "damage": 3 }] },
    "cold+force": { "name": "Shatter", "text": "Frozen, then struck: it shatters.", "ops": [{ "op": "hit", "n": 3 }] },
    "cold+lightning": { "name": "Conductive Arc", "text": "Frost carries the charge.", "ops": [{ "op": "arc", "damage": 2 }, { "op": "hit", "n": 1 }] },
    "heat+lightning": { "name": "Plasma Pop", "text": "Fire and lightning: it blows.", "ops": [{ "op": "explode", "damage": 3 }] },
    "force+motion": { "name": "Slingshot", "text": "Pushed and pulled at once.", "ops": [{ "op": "hit", "n": 2 }] }
  },
  "props": {
    "barrel": { "name": "Barrel", "hp": 1, "explodes": true, "damage": 3 },
    "oil_barrel": { "name": "Oil Barrel", "hp": 1, "spill": "oil" },
    "water_barrel": { "name": "Water Barrel", "hp": 1, "spill": "wet" },
    "totem": { "name": "Totem", "hp": 4, "cover": false }
  },
  "tiles": {
    "floor": { "heat": [{ "op": "burn" }] },
    "water": {
      "heat": [{ "op": "steam" }],
      "cold": [{ "op": "terrain", "to": "ice" }],
      "lightning": [{ "op": "arc", "damage": 2 }]
    },
    "wet": {
      "heat": [{ "op": "steam" }],
      "cold": [{ "op": "terrain", "to": "ice" }],
      "lightning": [{ "op": "arc", "damage": 2 }]
    },
    "ice": { "heat": [{ "op": "terrain", "to": "water" }] },
    "oil": { "heat": [{ "op": "ignite" }], "lightning": [{ "op": "ignite" }] },
    "gas": { "heat": [{ "op": "explode", "damage": 2 }], "lightning": [{ "op": "explode", "damage": 2 }] },
    "barrel": { "heat": [{ "op": "explode", "damage": 3 }], "lightning": [{ "op": "explode", "damage": 3 }] },
    "oil_barrel": { "heat": [{ "op": "explode", "damage": 2 }] }
  }
}
