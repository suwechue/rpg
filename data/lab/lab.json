{
  "comment": "Combat Lab settings (docs/COMBAT_LAB.md). showOnTitle: show the Lab on the title screen in any build (dev builds always do). levers: every rule the Lab can switch; 'default' is the cl_base value, data/lab/presets.json overrides them. Read only through src/core/combat/rules.gd.",
  "showOnTitle": false,
  "defaultPreset": "cl_base",
  "defaultFight": "ledge_day",
  "defaultParty": [
    { "class": "fighter", "level": 3 },
    { "class": "mage", "level": 3 },
    { "class": "rogue", "level": 3 }
  ],
  "partySize": 4,
  "maxLevel": 10,
  "names": { "mage": "Ash", "fighter": "Brick", "rogue": "Quill", "healer": "Sage", "bard": "Lyric" },
  "classDecks": {
    "fighter": ["card_strike", "card_strike"],
    "mage": ["card_strike", "card_strike"],
    "rogue": ["card_strike", "card_strike"],
    "healer": ["card_strike", "card_strike"],
    "bard": ["card_strike", "card_strike"]
  },
  "keywordCards": [],
  "levers": [
    { "id": "actionsPerTurn", "group": "turn", "type": "int", "default": 1, "min": 1, "max": 3, "name": "Actions per turn" },
    { "id": "moveSeparate", "group": "turn", "type": "bool", "default": true, "name": "Move is separate", "hint": "Off: moving uses an Action." },
    { "id": "splitMove", "group": "turn", "type": "bool", "default": true, "name": "Split move", "hint": "Move, act, then keep moving." },
    { "id": "quicksPerTurn", "group": "turn", "type": "int", "default": 1, "min": 0, "max": 3, "name": "Quicks per turn", "hint": "0 = no cap." },
    { "id": "strikeCost", "group": "turn", "type": "enum", "default": "action", "options": ["action", "quick"], "name": "Strike costs" },
    { "id": "undo", "group": "turn", "type": "enum", "default": "until_card", "options": ["until_card", "stack", "off"], "name": "Undo" },
    { "id": "hold", "group": "turn", "type": "bool", "default": false, "name": "Hold a card" },
    { "id": "turnStructure", "group": "turn", "type": "enum", "default": "team", "options": ["team", "alternate", "initiative"], "name": "Turn structure", "hint": "Team: the whole party, then all enemies. Alternate: one ally, one enemy. Initiative: the old order." },

    { "id": "handSize", "group": "cards", "type": "int", "default": 4, "min": 1, "max": 7, "name": "Hand size" },
    { "id": "keepHand", "group": "cards", "type": "bool", "default": true, "name": "Keep leftover cards" },
    { "id": "drawPerTurn", "group": "cards", "type": "enum", "default": "refill", "options": ["refill", "1", "2", "3"], "name": "Draw per turn" },
    { "id": "reshuffle", "group": "cards", "type": "enum", "default": "when_empty", "options": ["when_empty", "never"], "name": "Reshuffle the discard" },
    { "id": "reshuffleFatigue", "group": "cards", "type": "bool", "default": false, "name": "Fatigue on reshuffle" },
    { "id": "mpMax", "group": "cards", "type": "int", "default": 6, "min": 0, "max": 20, "name": "Max MP", "hint": "0 = the character's own." },
    { "id": "mpRegen", "group": "cards", "type": "int", "default": 2, "min": -1, "max": 10, "name": "MP per turn", "hint": "-1 = the character's own." },
    { "id": "cardsCostMp", "group": "cards", "type": "bool", "default": true, "name": "All cards cost MP", "hint": "Off: only Major and Grand spells do." },
    { "id": "exhaustOn", "group": "cards", "type": "bool", "default": true, "name": "Exhaust" },
    { "id": "keywordsOn", "group": "cards", "type": "bool", "default": true, "name": "Keywords", "hint": "Free, Follow-up, Swift, Heavy." },
    { "id": "teammateCards", "group": "cards", "type": "bool", "default": true, "name": "Teammate cards" },
    { "id": "discardCards", "group": "cards", "type": "bool", "default": true, "name": "Discard cards" },
    { "id": "classDecks", "group": "cards", "type": "enum", "default": "lab", "options": ["lab", "game"], "name": "Class decks" },
    { "id": "extraKeywordCards", "group": "cards", "type": "int", "default": 0, "min": 0, "max": 4, "name": "Extra Free and Follow-up cards", "hint": "Added to each deck." },

    { "id": "smallNumbers", "group": "numbers", "type": "bool", "default": true, "name": "Small numbers" },
    { "id": "hpScale", "group": "numbers", "type": "float", "default": 0.25, "min": 0.05, "max": 2.0, "step": 0.05, "name": "Enemy HP scale" },
    { "id": "bossHpScale", "group": "numbers", "type": "float", "default": 0.15, "min": 0.05, "max": 2.0, "step": 0.05, "name": "Boss HP scale" },
    { "id": "partyHpScale", "group": "numbers", "type": "float", "default": 0.33, "min": 0.05, "max": 2.0, "step": 0.01, "name": "Party HP scale" },
    { "id": "damageScale", "group": "numbers", "type": "float", "default": 0.4, "min": 0.05, "max": 2.0, "step": 0.05, "name": "Damage scale" },
    { "id": "flatDamageMul", "group": "numbers", "type": "float", "default": 1.0, "min": 0.5, "max": 5.0, "step": 0.5, "name": "Flat card numbers x", "hint": "Lab cards are written in small numbers. Raise this when small numbers are off." },
    { "id": "crits", "group": "numbers", "type": "bool", "default": false, "name": "Crits" },
    { "id": "misses", "group": "numbers", "type": "bool", "default": false, "name": "Misses" },
    { "id": "difficultyDamageMul", "group": "numbers", "type": "bool", "default": false, "name": "Difficulty damage multiplier" },
    { "id": "instability", "group": "numbers", "type": "bool", "default": true, "name": "Instability rolls" },

    { "id": "collisionDamage", "group": "board", "type": "int", "default": 2, "min": 0, "max": 10, "name": "Collision damage" },
    { "id": "domino", "group": "board", "type": "bool", "default": false, "name": "Domino", "hint": "A push chains into the unit it hits." },
    { "id": "pitKillsEnemies", "group": "board", "type": "bool", "default": true, "name": "Pits kill enemies" },
    { "id": "pitDamageParty", "group": "board", "type": "int", "default": 3, "min": 0, "max": 20, "name": "Pit damage to party", "hint": "0 = a share of max HP (the old rule)." },
    { "id": "fallDamage", "group": "board", "type": "int", "default": 2, "min": 0, "max": 10, "name": "Ledge fall damage" },
    { "id": "iceSlide", "group": "board", "type": "bool", "default": true, "name": "Ice slides" },
    { "id": "propsDensity", "group": "board", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.25, "name": "Props kept", "hint": "Share of a fight's props on the map." },
    { "id": "reactionsTable", "group": "board", "type": "enum", "default": "default", "options": ["default", "off"], "name": "Terrain reactions" },
    { "id": "enemiesAvoidEdges", "group": "board", "type": "bool", "default": true, "name": "Enemies avoid edges" },

    { "id": "telegraphTiming", "group": "telegraphs", "type": "enum", "default": "start_of_player_turn", "options": ["start_of_player_turn", "before_acting"], "name": "Telegraph timing" },
    { "id": "trackingShare", "group": "telegraphs", "type": "float", "default": 0.1, "min": -1.0, "max": 1.0, "step": 0.1, "name": "Tracking attack share", "hint": "-1 = what the enemy data says." },
    { "id": "pathBlocking", "group": "telegraphs", "type": "bool", "default": true, "name": "Things in the path take the shot" },
    { "id": "redirect", "group": "telegraphs", "type": "bool", "default": true, "name": "Enemies hit each other" },
    { "id": "hitHardRarely", "group": "telegraphs", "type": "bool", "default": false, "name": "Enemies hit hard but rarely" },
    { "id": "hitHardMul", "group": "telegraphs", "type": "float", "default": 2.0, "min": 1.0, "max": 4.0, "step": 0.5, "name": "Hard hit x" },
    { "id": "blindMode", "group": "telegraphs", "type": "enum", "default": "adjacent_tile", "options": ["adjacent_tile", "miss_chance"], "name": "Blind" },

    { "id": "surge", "group": "rewards", "type": "bool", "default": true, "name": "Surge meter" },
    { "id": "surgeSize", "group": "rewards", "type": "int", "default": 5, "min": 1, "max": 12, "name": "Surge size" },
    { "id": "killRefund", "group": "rewards", "type": "enum", "default": "move", "options": ["move", "action", "off"], "name": "Kill refund" },
    { "id": "comboChain", "group": "rewards", "type": "bool", "default": true, "name": "Combo chain" },

    { "id": "roundCap", "group": "pacing", "type": "int", "default": 8, "min": 0, "max": 30, "name": "Round cap", "hint": "0 = none. Past it, the Upside-Down shifts." },
    { "id": "shiftDamage", "group": "pacing", "type": "int", "default": 1, "min": 0, "max": 5, "name": "Shift damage per round" },
    { "id": "enemyCount", "group": "pacing", "type": "int", "default": 0, "min": 0, "max": 12, "name": "Enemy count", "hint": "0 = what the fight says." },
    { "id": "goal", "group": "pacing", "type": "enum", "default": "", "options": ["", "kill", "survive"], "name": "Goal override", "hint": "Blank = what the fight says." },

    { "id": "enemyHpMul", "group": "difficulty", "type": "float", "default": 1.0, "min": 0.25, "max": 4.0, "step": 0.25, "name": "Enemy HP x" },
    { "id": "enemyDamageMul", "group": "difficulty", "type": "float", "default": 1.0, "min": 0.25, "max": 4.0, "step": 0.25, "name": "Enemy damage x" },
    { "id": "extraEnemies", "group": "difficulty", "type": "int", "default": 0, "min": 0, "max": 6, "name": "Extra enemies" },
    { "id": "enemyAbilitiesTier", "group": "difficulty", "type": "int", "default": 3, "min": 1, "max": 3, "name": "Enemy abilities tier", "hint": "Enemy actions marked with a higher abilityTier are left out." }
  ]
}
